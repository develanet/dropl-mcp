{
  "name": "@dropl/mcp",
  "version": "0.6.0",
  "description": "Create client-editable photo and video galleries from Cursor or Claude Code, then embed them.",
  "mcpName": "io.dropl/mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cursor",
    "claude",
    "claude-code",
    "ai-agent",
    "photo-gallery",
    "video-hosting",
    "gallery-embed",
    "client-portal",
    "nextjs",
    "webflow",
    "framer",
    "wordpress",
    "headless-cms",
    "dropl"
  ],
  "homepage": "https://www.dropl.io/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/develanet/dropl-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/develanet/dropl-mcp/issues"
  },
  "license": "MIT",
  "author": "Dropl (https://www.dropl.io)",
  "type": "module",
  "bin": {
    "dropl-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync-version": "node scripts/sync-version.mjs",
    "check:tools": "node scripts/check-tools.mjs",
    "prepublishOnly": "node scripts/sync-version.mjs && npm run build && node scripts/check-tools.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dropl/shared": "workspace:*",
    "@dropl/typescript-config": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
