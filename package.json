{
  "name": "@dropl/mcp",
  "version": "0.2.0",
  "description": "MCP server that lets AI coding agents create Dropl client sites and showcases, upload photos and videos, and fetch embed code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dropl-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dropl/shared": "workspace:*",
    "@dropl/typescript-config": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
